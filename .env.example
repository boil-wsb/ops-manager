# Application
APP_NAME=OpsManager V2
APP_VERSION=1.0.0
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://opsmanager:opsmanager@postgres:5432/opsmanager
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth Whitelist Configuration
AUTH_EXCLUDED_PATHS=/api/v1/feishu/notify,/api/v1/it-reporter,/api/v1/open-id,/api/v1/alert/webhook/alertmanager
AUTH_TRUSTED_NETWORKS=127.0.0.1/32,192.168.0.0/16,10.0.0.0/8

# Alert Aggregation Configuration
ALERT_AGGREGATION_WINDOW_SECONDS=300

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_SECURE=false
