# Application
APP_NAME=OpsManager V2
APP_VERSION=1.0.0
DEBUG=false

# Security
# REQUIRED: Generate a secure random key (at least 32 characters)
# Example: openssl rand -base64 32
SECRET_KEY=change-this-to-a-secure-random-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://opsmanager:opsmanager@localhost:5432/opsmanager
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Audit Log Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DB_RETENTION_DAYS=90
AUDIT_LOG_FILE_RETENTION_DAYS=365
AUDIT_LOG_FILE_PATH=logs/audit.log
AUDIT_LOG_ASYNC=true
AUDIT_LOG_MAX_FILE_SIZE=100MB
AUDIT_LOG_BACKUP_COUNT=10

# MinIO Configuration
MINIO_ENDPOINT=192.168.23.36:9000
MINIO_ACCESS_KEY=fYIukgJZaLOivnFimLVX
MINIO_SECRET_KEY=shdyfYIukgJZaLOivnFimLVX123
MINIO_SECURE=false

# IT Reporter Configuration
ITREPORTER_CHAT_ID=oc_e3b21f3ea3254145fb4df9553e4b199b
ITREPORTER_MINIO_BUCKET=reports
ITREPORTER_PRESIGNED_URL_EXPIRES_HOURS=2
ITREPORTER_REPORT_PATH=devops-scripts/{date}-health-check.html

# Auth Whitelist Configuration
AUTH_EXCLUDED_PATHS=/api/v1/feishu/notify,/api/v1/it-reporter,/api/v1/open-id
AUTH_TRUSTED_NETWORKS=192.168.0.0/16,10.0.0.0/8
