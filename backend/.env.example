# Application
APP_NAME=OpsManager V2
APP_VERSION=1.0.0
DEBUG=false

# Security
# REQUIRED: Generate a secure random key (at least 32 characters)
# Example: openssl rand -base64 32
SECRET_KEY=change-this-to-a-secure-random-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (Docker Compose uses DB_USER/DB_PASSWORD/DB_NAME to create the database)
DB_USER=opsmanager
DB_PASSWORD=opsmanager
DB_NAME=opsmanager
# For local development: use localhost; for Docker Compose: overridden by environment in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://opsmanager:opsmanager@localhost:5432/opsmanager
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
# For local development: use localhost; for Docker Compose: overridden by environment in docker-compose.yml
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_DIR=logs
LOG_FILE_RETENTION_DAYS=30

# Audit Log Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DB_RETENTION_DAYS=90
AUDIT_LOG_FILE_RETENTION_DAYS=365
AUDIT_LOG_FILE_PATH=logs/audit.log
AUDIT_LOG_ASYNC=true
AUDIT_LOG_MAX_FILE_SIZE=100MB
AUDIT_LOG_BACKUP_COUNT=10

# Feishu
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_ENABLE=false

# Ansible SSH Configuration
ANSIBLE_SSH_HOST=localhost
ANSIBLE_SSH_PORT=22
ANSIBLE_SSH_USERNAME=
ANSIBLE_SSH_PASSWORD=
ANSIBLE_COMMAND=cd /home/shdy/.ansible && ansible-playbook -i inventory/incloud_all/hosts playbooks/site.yml -l all
ANSIBLE_LOCAL_SCRIPT_PATH=
ANSIBLE_SCHEDULE_HOUR=12
ANSIBLE_SCHEDULE_MINUTE=0

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_SECURE=false

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090

# IT Reporter Configuration
ITREPORTER_CHAT_ID=your-feishu-chat-id
ITREPORTER_MINIO_BUCKET=devops-scripts
ITREPORTER_PRESIGNED_URL_EXPIRES_HOURS=2
ITREPORTER_REPORT_PATH=IT-days-reporter/health_check_detailed_report_{date_compact}
ITREPORTER_DOWNLOAD_BASE_URL=http://localhost:8080

# Default Admin Configuration
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Feishu Sync Default Password
FEISHU_SYNC_DEFAULT_PASSWORD=change-this-password

# IT Feedback Local IP Mapping (format: local_alias:real_ip,local_alias2:real_ip2)
LOCAL_IP_MAPPING=

# PC Client Info Configuration
PCINFO_PUSHGATEWAY_URL=http://localhost:9091/metrics/job/pcinfo
PCINFO_UPDATE_SERVER_HOST=localhost
PCINFO_UPDATE_SERVER_PORT=8080

# Auth Whitelist Configuration
AUTH_EXCLUDED_PATHS=/api/v1/feishu/notify,/api/v1/it-reporter,/api/v1/open-id
AUTH_TRUSTED_NETWORKS=127.0.0.1/32,192.168.0.0/16,10.0.0.0/8

# Auth Service Internal Reset Token（/auth-service/reset-password 调用方共享密钥；为空则拒绝密码重置）
AUTH_SERVICE_RESET_TOKEN=
